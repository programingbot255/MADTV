{
  "name": "mad-watch-tv",
  "version": "1.1.2",
  "scripts": {
    "dev": "node -e \"const fs=require('fs'); if(!fs.existsSync('public/logo')){fs.mkdirSync('public/logo',{recursive:true});} if(fs.existsSync('logo/Logo-PNG.png')){fs.copyFileSync('logo/Logo-PNG.png','public/logo/Logo-PNG.png');}\" && vite --port 3000 --host 0.0.0.0",
    "build": "node build-all.js",
    "sync": "npx cap sync",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
