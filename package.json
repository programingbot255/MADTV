{
  "name": "mad-watch-tv",
  "version": "1.1.2",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "build": "vite build && node -e \"if (require('fs').existsSync('postbuild.js')) require('./postbuild.js')\" && node -e \"if (require('fs').existsSync('build.js')) require('./build.js')\"",
    "sync": "npx cap sync",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
